# Shell scripts must remain runnable after a Windows checkout and push.
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.spec text eol=lf
*.md text eol=lf
*.ico binary
*.icns binary
*.png binary
*.gif binary
# Preserve upstream notices verbatim and keep imported license collections out
# of code diffs (their original headings can resemble merge conflict markers).
assets/licenses/*.txt text eol=lf -diff
